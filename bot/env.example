# ========= Orion Outreach Bot — variáveis de ambiente (exemplo) =========
# Copie para .env e preencha. NUNCA versione o .env real.

# --- Timezone / janela ---
GENERIC_TIMEZONE=America/Sao_Paulo
JANELA_INICIO=9          # hora (09h)
JANELA_FIM=18            # hora (18h)
DIAS_UTEIS=1-5           # seg a sex

# --- n8n ---
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_ENCRYPTION_KEY=troque-por-uma-chave-aleatoria

# --- Postgres (estado/opt-out/log) ---
PGHOST=postgres
PGPORT=5432
PGDATABASE=orion
PGUSER=orion
PGPASSWORD=troque-me

# --- SMTP / E-mail (HostGator — remetente real = Edmar) ---
# 1) Crie a caixa no cPanel do HostGator: Contas de E-mail > Criar > comercial@edmarsantos.com.br
# 2) O host/porta estão em cPanel > Contas de E-mail > Conectar Dispositivos (SMTP seguro).
SMTP_HOST=mail.edmarsantos.com.br      # servidor SMTP do HostGator p/ o domínio (confirme no cPanel)
SMTP_PORT=465                          # 465 = SSL (ou 587 = TLS)
SMTP_USER=comercial@edmarsantos.com.br
SMTP_PASS=senha-da-caixa               # senha da caixa criada no cPanel
EMAIL_FROM_NAME=Edmar Santos — Orion Planetários
EMAIL_REPLY_TO=comercial@edmarsantos.com.br
# Entregabilidade: no cPanel > Email Deliverability, ative/valide SPF e DKIM do domínio.
# Caminho do PDF anexado (apresentação protegida)
ANEXO_APRESENTACAO=/data/docs/apresentacao_orion_protegido.pdf

# --- Controle de envio de e-mail ---
# draft  = só monta rascunho e põe na fila "revisar" (padrão, compliance §2/§8)
# auto   = envia automaticamente SOMENTE para escolas com aprovado=true (lista pré-aprovada)
EMAIL_MODO=draft

# --- Evolution API (WhatsApp) ---
EVOLUTION_URL=http://evolution:8080
EVOLUTION_INSTANCE=orion
EVOLUTION_APIKEY=troque-me
WHATSAPP_MAX_TOQUES=2

# --- Opt-out ---
OPTOUT_PALAVRAS=sair,não tenho interesse,nao tenho interesse,descadastrar,remover
OPTOUT_BLOQUEIO_DIAS=60
