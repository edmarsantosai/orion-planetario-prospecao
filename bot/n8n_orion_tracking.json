{
  "id": "oriontracking1",
  "name": "Orion — Tracking (aberturas + cliques)",
  "active": false,
  "settings": { "timezone": "America/Sao_Paulo" },
  "pinData": {},
  "nodes": [
    {
      "parameters": { "httpMethod": "GET", "path": "orion/open", "responseMode": "responseNode", "options": {} },
      "id": "t1000000-0000-4000-8000-000000000001",
      "name": "Webhook Abertura",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-640, -120],
      "webhookId": "orion-open",
      "notes": "Pixel 1x1 no corpo do e-mail: GET /webhook/orion/open?e=<id_escola>. Loga abertura. Caveat: Gmail faz proxy/cache de imagens => abertura e aproximada (pode contar no momento da entrega)."
    },
    {
      "parameters": {
        "operation": "insert",
        "schema": { "__rl": true, "mode": "list", "value": "public" },
        "table": { "__rl": true, "mode": "list", "value": "eventos" },
        "columns": { "mappingMode": "defineBelow", "value": {
          "escola_id": "={{ $json.query.e }}", "canal": "email", "etapa": "track", "acao": "abertura", "detalhe": "={{ $json.headers['user-agent'] || '' }}"
        } }
      },
      "id": "t1000000-0000-4000-8000-000000000002",
      "name": "Log Abertura",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [-400, -120],
      "credentials": { "postgres": { "id": "orion-pg", "name": "Orion Postgres" } },
      "continueOnFail": true
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "",
        "options": { "responseCode": 200, "responseHeaders": { "entries": [ { "name": "Content-Type", "value": "image/gif" }, { "name": "Cache-Control", "value": "no-store" } ] } }
      },
      "id": "t1000000-0000-4000-8000-000000000003",
      "name": "Responde Pixel",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [-160, -120]
    },
    {
      "parameters": { "httpMethod": "GET", "path": "orion/click", "responseMode": "responseNode", "options": {} },
      "id": "t1000000-0000-4000-8000-000000000004",
      "name": "Webhook Clique",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-640, 160],
      "webhookId": "orion-click",
      "notes": "Links do e-mail passam por aqui: GET /webhook/orion/click?e=<id>&u=whatsapp|video. Loga o clique e redireciona (302) para o destino real."
    },
    {
      "parameters": {
        "jsCode": "const q = $json.query || {};\nconst map = {\n  whatsapp: 'https://wa.me/5547992009480?text=Oi%20Edmar!%20Quero%20saber%20sobre%20o%20Planet%C3%A1rio%20na%20escola.',\n  video: 'https://www.youtube.com/watch?v=Lr5xn2BRIG0'\n};\nreturn [{ json: { e: q.e || '', u: q.u || '', url: map[q.u] || 'https://orionplanetarios.com.br' } }];"
      },
      "id": "t1000000-0000-4000-8000-000000000005",
      "name": "Mapear destino",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-400, 160]
    },
    {
      "parameters": {
        "operation": "insert",
        "schema": { "__rl": true, "mode": "list", "value": "public" },
        "table": { "__rl": true, "mode": "list", "value": "eventos" },
        "columns": { "mappingMode": "defineBelow", "value": {
          "escola_id": "={{ $json.e }}", "canal": "email", "etapa": "track", "acao": "clique", "detalhe": "={{ $json.u }}"
        } }
      },
      "id": "t1000000-0000-4000-8000-000000000006",
      "name": "Log Clique",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [-160, 160],
      "credentials": { "postgres": { "id": "orion-pg", "name": "Orion Postgres" } },
      "continueOnFail": true
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "",
        "options": { "responseCode": 302, "responseHeaders": { "entries": [ { "name": "Location", "value": "={{ $('Mapear destino').item.json.url }}" } ] } }
      },
      "id": "t1000000-0000-4000-8000-000000000007",
      "name": "Redireciona",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [80, 160]
    }
  ],
  "connections": {
    "Webhook Abertura": { "main": [ [ { "node": "Log Abertura", "type": "main", "index": 0 } ] ] },
    "Log Abertura": { "main": [ [ { "node": "Responde Pixel", "type": "main", "index": 0 } ] ] },
    "Webhook Clique": { "main": [ [ { "node": "Mapear destino", "type": "main", "index": 0 } ] ] },
    "Mapear destino": { "main": [ [ { "node": "Log Clique", "type": "main", "index": 0 } ] ] },
    "Log Clique": { "main": [ [ { "node": "Redireciona", "type": "main", "index": 0 } ] ] }
  }
}
